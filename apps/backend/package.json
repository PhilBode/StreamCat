    "@streamcat/db": "workspace:*",
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/eventsub-base": "^8.2.0",
    "@twurple/eventsub-http": "^8.2.0",
    "@twurple/eventsub-ws": "^8.2.0",
    "discord.js": "^14.27.0",
    "reflect-metadata": "^0.2.2",
