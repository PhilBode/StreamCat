# One public HTTPS origin for dashboard, OAuth and Twitch webhooks.
# Local Bun/VS Code: Cloudflared forwards this domain to the local web server.
PUBLIC_URL=https://streamcat.example.com

# Discord bot + dashboard (same application)
DISCORD_TOKEN=your_discord_bot_token
AUTH_DISCORD_ID=your_discord_app_id
AUTH_DISCORD_SECRET=your_discord_app_secret

# Twitch app; connect the shared bot account with /twitch-bot login.
TWITCH_APP_CLIENT_ID=your_twitch_app_client_id
TWITCH_APP_SECRET=your_twitch_app_secret

# Optional: enables the bundled Cloudflared tunnel. Empty leaves it disabled.
# TUNNEL_TOKEN=your_cloudflare_tunnel_token

# Optional: error, warn, info (default), debug. Applies locally and in Docker.
# LOG_LEVEL=debug
