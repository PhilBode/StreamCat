{
  "name": "@streamcat/overlay-engine",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
